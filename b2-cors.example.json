{
  "CORSRules": [
    {
      "AllowedOrigins": ["https://YOUR-PRODUCTION-DOMAIN.example"],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["Range"],
      "ExposeHeaders": [
        "Accept-Ranges",
        "Content-Range",
        "Content-Length",
        "ETag"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
