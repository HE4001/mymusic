{
  "name": "cloud-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "validate:library": "tsx scripts/validate-library.ts",
    "test": "vitest run",
    "test:ablation": "node scripts/ablation.mjs",
    "build": "npm run validate:library && vite build && wrangler pages functions build functions --outdir .build/functions",
    "preview:pages": "wrangler pages dev dist",
    "deploy": "npm run check && npm run build && wrangler pages deploy dist --project-name cloud-music"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.1"
  }
}
