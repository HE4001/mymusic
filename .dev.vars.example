# Copy to .dev.vars for local Pages Functions development and replace every placeholder.
# Keep .dev.vars local; never commit real credentials or paste them into chat.
# In deployed Pages environments, store B2_BUCKET, B2_KEY_ID, and
# B2_APPLICATION_KEY as Secrets. Presigned URLs expose the bucket and key ID;
# the application key must never be returned or logged.
B2_ENDPOINT=https://s3.YOUR-REGION.backblazeb2.com
B2_REGION=YOUR-REGION
B2_BUCKET=YOUR-BUCKET
B2_KEY_ID=YOUR-READ-ONLY-KEY-ID
B2_APPLICATION_KEY=YOUR-READ-ONLY-APPLICATION-KEY

# Website password: at least 12 characters. Store as a Pages Secret.
SITE_PASSWORD=CHANGE-THIS-LOCAL-PLACEHOLDER
